# העתק קובץ זה ל-.env בשורש הפרויקט ומלא ערכים אמיתיים.
# פרטים מלאים איך להשיג אותם נמצאים ב-MONGODB_SETUP.md

# מחרוזת חיבור למונגו (מקומי או Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/stage-web-project

# מחרוזת סודית לחתימת טוקני התחברות (JWT). שימו מחרוזת אקראית וארוכה משלכם.
JWT_SECRET=change-this-to-a-long-random-secret

# פורט לשרת ה-API (אופציונלי, ברירת מחדל 5050)
PORT=5050
